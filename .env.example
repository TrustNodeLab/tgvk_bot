# Video Factory environment template.
# Copy to .env and fill. NEVER commit real secrets.
# Worker/CI already has these secrets configured; this file is for local runs.

# --- LLM (script generation) ---
# Provider: gigachat | gemini | openai | template
LLM_PROVIDER=gigachat
# GigaChat: service account JWT or API key (Basic auth)
LLM_API_KEY=
GIGACHAT_MODEL=GigaChat-Pro
# Gemini fallback
GEMINI_API_KEY=
# OpenAI-compatible
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- TTS ---
# Provider: voicestudio | edge | elevenlabs | test
TTS_PROVIDER=voicestudio
VOICESTUDIO_URL=http://127.0.0.1:3900/v1
VOICESTUDIO_VOICE=alloy
VOICESTUDIO_TIMEOUT=640
# Edge TTS (free fallback)
VOICE_DEFAULT=ru-RU-DmitryNeural
# ElevenLabs
ELEVENLABS_API_KEY=
VOICE_ID=onwK4e9ZLuTAKqWW03F9

# --- Visuals ---
PEXELS_API_KEY=

# --- Storage & callbacks ---
BOT_WORKER_URL=https://tgvk-bot-webhook.yellowwhale2008.workers.dev
BOT_WORKER_TOKEN=
JOB_CALLBACK_SECRET=
STORAGE_TYPE=local            # local | r2 | telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Behaviour ---
TEST_MODE=0                   # 1 = template LLM + test TTS, no network providers
VF_LOG_LEVEL=INFO